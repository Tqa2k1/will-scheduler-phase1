generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ShiftAdjustmentConfirmation {
  id              String   @id @default(cuid())
  month           String   @unique
  shortagesByDate Json
  confirmedAt     DateTime @default(now())
  confirmedBy     String?
  // 1回目Gmail（勤務希望登録のお願い）の送信記録。二重送信防止と、スキップ者のログ用（2026-10追加・nullable）
  notifiedAt      DateTime?
  notifiedBy      String?
  notifyResult    Json?
}

// 月ごとの勤務スケジュールの確定状態（2026-10追加。2026-10 v17 でステータスを明示的に保持）。
//  - 行なし／ADJUSTING … 「調整中」。従業員の勤務表には「調整中」とだけ表示し、シフト内容は返さない
//  - CONFIRMED          … 「確定」。「メール配信」が正常に完了した月だけ。従業員は全員分のシフトを閲覧できる
// メール送信ログからの推測ではなく、この status を唯一の根拠にする。
// 旧仕様で「確定」を押していた月（status 列が無かった行）は、列追加時に CONFIRMED のまま引き継がれる。
model MonthRosterConfirmation {
  id                   String            @id @default(cuid())
  month                String            @unique
  status               RosterMonthStatus @default(CONFIRMED)
  // 直近で「確定」になった日時・実行者（ADJUSTING のまま未確定の行は null）
  confirmedAt          DateTime?
  confirmedBy          String?
  // 確定後にシフト（MonthRoster）が修正された場合 true（= 「調整中・再配信が必要」）。再度の配信成功で false に戻る
  revisedAfterConfirm  Boolean           @default(false)
  revisedAt            DateTime?
  revisedBy            String?
  // シフトが修正されるたびに +1。「どの版を配信したか」の判定（配信失敗時の再送で送信済みの人を飛ばす）に使う
  revision             Int               @default(0)
  // 直近のメール配信の記録（成功した従業員ID・失敗・スキップ）
  lastDeliveryAt       DateTime?
  lastDeliveryRevision Int?
  lastDeliveryResult   Json?
  updatedAt            DateTime          @default(now()) @updatedAt
}

enum RosterMonthStatus {
  ADJUSTING
  CONFIRMED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(EMPLOYEE)
  employeeId   String?   @unique
  createdAt    DateTime  @default(now())
  employee     Employee? @relation(fields: [employeeId], references: [id])
}

model Employee {
  id                  String                    @id @default(cuid())
  fullName            String
  role                EmployeeRole              @default(STAFF)
  commuteType         CommuteType?
  isActive            Boolean                   @default(true)
  note                String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  baseEndTime         String?
  baseStartTime       String?
  contactEmail        String?
  priorityOrder       Int                       @default(0)
  breaks              Break[]
  dailyAssignments    DailyAssignment[]
  rotationPatterns    EmployeeRotationPattern[]
  incidentFlags       IncidentFlag[]
  monthRoster         MonthRoster[]
  personalConstraints PersonalConstraint[]
  shiftClaimRequests  ShiftClaimRequest[]
  user                User?
}

model ShiftType {
  id                 String              @id @default(cuid())
  code               String              @unique
  name               String
  defaultStartTime   String
  defaultEndTime     String
  spansMidnight      Boolean             @default(false)
  // 基本必要人数（INCが /shift-settings で設定。null/0 = 人員不足の集計対象外）
  requiredCount      Int?
  monthRoster        MonthRoster[]
  shiftClaimRequests ShiftClaimRequest[]
  timeBands          ShiftTimeBand[]
}

// シフト内の時間帯別必要人数。設定がある時間帯は ShiftType.requiredCount より優先される。
model ShiftTimeBand {
  id            String    @id @default(cuid())
  shiftTypeId   String
  startTime     String
  endTime       String
  requiredCount Int
  shiftType     ShiftType @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)

  @@index([shiftTypeId])
}

model MonthRoster {
  id                String       @id @default(cuid())
  employeeId        String
  workDate          DateTime     @db.Date
  shiftTypeId       String?
  status            RosterStatus @default(WORK)
  createdBy         String?
  updatedBy         String?
  updatedAt         DateTime     @updatedAt
  createdAt         DateTime     @default(now())
  overrideEndTime   String?
  overrideStartTime String?
  employee          Employee     @relation(fields: [employeeId], references: [id])
  shiftType         ShiftType?   @relation(fields: [shiftTypeId], references: [id])

  @@unique([employeeId, workDate])
  @@index([workDate])
}

model CartPosition {
  id                 String               @id @default(cuid())
  code               String               @unique
  name               String
  category           PositionCategory
  description        String?
  isActive           Boolean              @default(true)
  operatingEndTime   String?
  operatingStartTime String?
  color              String?
  operatingHours     CartOperatingHours[]
  dailyAssignments   DailyAssignment[]
  demandTemplates    DemandTemplate[]
  requirements       TaskRequirement[]
}

model TaskRequirement {
  id                String         @id @default(cuid())
  cartPositionId    String
  appliesToAllRoles Boolean        @default(true)
  targetRoles       EmployeeRole[]
  requiredCount     Int            @default(1)
  note              String?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  cartPosition      CartPosition   @relation(fields: [cartPositionId], references: [id])

  @@index([cartPositionId])
}

model RolePriority {
  id            String       @id @default(cuid())
  role          EmployeeRole @unique
  priorityOrder Int
  updatedAt     DateTime     @updatedAt
}

model CartOperatingHours {
  id             String       @id @default(cuid())
  cartPositionId String
  dayTemplate    String
  startTime      String
  endTime        String
  cartPosition   CartPosition @relation(fields: [cartPositionId], references: [id])
}

model DemandTemplate {
  id             String       @id @default(cuid())
  cartPositionId String
  dayTemplate    String
  timeSlot       String
  requiredCount  Int          @default(0)
  cartPosition   CartPosition @relation(fields: [cartPositionId], references: [id])

  @@unique([cartPositionId, dayTemplate, timeSlot])
}

model DailyAssignment {
  id             String       @id @default(cuid())
  employeeId     String
  workDate       DateTime     @db.Date
  slotStart      String
  slotEnd        String
  cartPositionId String
  source         String       @default("MANUAL")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  cartPosition   CartPosition @relation(fields: [cartPositionId], references: [id])
  employee       Employee     @relation(fields: [employeeId], references: [id])

  @@index([workDate, slotStart])
  @@index([employeeId, workDate])
}

model Break {
  id              String   @id @default(cuid())
  employeeId      String
  workDate        DateTime @db.Date
  breakStart      String
  breakEnd        String
  requiredMinutes Int
  actualMinutes   Int?
  employee        Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, workDate])
}

model RotationPattern {
  id                String                    @id @default(cuid())
  code              String                    @unique
  name              String
  patternDefinition Json
  isActive          Boolean                   @default(true)
  employees         EmployeeRotationPattern[]
}

model EmployeeRotationPattern {
  id                String          @id @default(cuid())
  employeeId        String
  rotationPatternId String
  anchorDate        DateTime        @db.Date
  createdAt         DateTime        @default(now())
  isCurrent         Boolean         @default(true)
  employee          Employee        @relation(fields: [employeeId], references: [id])
  rotationPattern   RotationPattern @relation(fields: [rotationPatternId], references: [id])

  @@index([employeeId, isCurrent])
}

model PersonalConstraint {
  id             String         @id @default(cuid())
  employeeId     String
  workDate       DateTime       @db.Date
  rangeStart     String?
  rangeEnd       String?
  constraintType ConstraintType
  note           String?
  employee       Employee       @relation(fields: [employeeId], references: [id])

  @@index([employeeId, workDate])
}

model IncidentFlag {
  id         String       @id @default(cuid())
  employeeId String
  workDate   DateTime     @db.Date
  flagType   IncidentType
  note       String?
  recordedBy String?
  recordedAt DateTime     @default(now())
  employee   Employee     @relation(fields: [employeeId], references: [id])
}

model ShiftClaimRequest {
  id          String           @id @default(cuid())
  employeeId  String
  workDate    DateTime         @db.Date
  status      ShiftClaimStatus @default(PENDING)
  requestedAt DateTime         @default(now())
  decidedAt   DateTime?
  decidedBy   String?
  shiftTypeId String?
  requestedStartTime String?
  requestedEndTime   String?
  // 取消申請（承認済み勤務の取消依頼）をした日時。取消の履歴はここと RosterAuditLog に残す（2026-10追加・nullable）
  cancelRequestedAt  DateTime?
  employee    Employee         @relation(fields: [employeeId], references: [id])
  shiftType   ShiftType?       @relation(fields: [shiftTypeId], references: [id])

  @@unique([employeeId, workDate])
  @@index([workDate, status])
}

// 1回目メール（勤務希望登録のお願い）の「月×従業員」ごとの送信記録（2026-10追加）。
// 一意制約で二重送信を防ぎ、再送は未送信・失敗の従業員だけに行うために使う。
model ShortageMailLog {
  id           String   @id @default(cuid())
  month        String
  employeeId   String
  employeeName String
  // SENDING: 送信処理中 / SENT: 送信成功 / FAILED: 送信失敗
  status       String
  // 送信したときのMAIL_MODE（live / dry-run / test）。live以外で「送信済み」になった人は、live切替後に再送の対象になる
  mode         String?
  reason       String?
  attempts     Int      @default(0)
  sentAt       DateTime?
  sentBy       String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([month, employeeId])
  @@index([month, status])
}

model RosterAuditLog {
  id        String   @id @default(cuid())
  tableName String
  recordId  String
  action    String
  changedBy String?
  changedAt DateTime @default(now())
  oldValue  Json?
  newValue  Json?

  @@index([tableName, recordId])
}

enum UserRole {
  ADMIN
  INC
  EMPLOYEE
}

enum EmployeeRole {
  INC
  RESPONSIBLE // 責任者（2026-09追加。OFFICE優先ルールの対象。詳細はAUTO_ASSIGN_RULES.md参照）
  STAFF
  OJT
  CONTRACT
  PARTTIME
}

enum CommuteType {
  TAXI_ONE_WAY
  OWN_CAR
  OTHER
}

enum RosterStatus {
  WORK
  PAID_LEAVE
  ADJUST_LEAVE
  OFF
}

enum PositionCategory {
  CART
  SPECIAL
}

enum ConstraintType {
  NG
  OK
}

enum IncidentType {
  LATE
  DELAY
  EARLY_LEAVE
  OVERTIME
  BF_FEE_CUT
  OWN_CAR_COMMUTE
  ONE_WAY_TAXI
}

enum ShiftClaimStatus {
  // INCが一括メールで依頼を送っただけで、本人はまだ何も回答していない状態。
  // 「メールを送信した」と「本人が実際に勤務希望を登録した」を区別するための状態（2026-09追加）。
  INVITED
  // 本人が実際に勤務希望を登録し、INCの承認待ちの状態。
  PENDING
  APPROVED
  REJECTED
  // 2026-10追加: 承認済みの勤務の取消をINCに申請中（承認されると CANCELED、却下されると APPROVED に戻る）
  CANCEL_REQUESTED
  // 取消済み（本人が承認前に取消、またはINCが取消を承認）。履歴として残す
  CANCELED
  // 一括確定で選ばれなかった応募（不採用）。履歴として残す
  NOT_SELECTED
}

// 対象月ごとの「勤務希望の登録停止／再開」（2026-10追加）。INCが「応募者の確認・勤務者の確定」画面で操作する。
// 行がない月は「受付中」。停止中は従業員が対象月の勤務希望を新規登録・変更できない（既存データは削除しない）。
// 未確定の勤務希望の取消は停止中でも可能。
model ClaimRegistrationHold {
  id        String   @id @default(cuid())
  month     String   @unique // "2026-11"（勤務日の属する月）
  isStopped Boolean  @default(true)
  updatedBy String?
  updatedAt DateTime @default(now()) @updatedAt
}

// AI依頼の「整理済みメモ」（過去の会話をすべて保存せず、管理者の依頼の要点だけを月ごとに少数保持して再利用する）。
// 追加のみ（既存テーブルには影響しない）。古いメモは自動で削除される（月ごとに最新20件まで）。
model AiMemory {
  id        String   @id @default(cuid())
  scope     String // 対象月 "2026-11"
  note      String // 依頼と結果の要点（160文字程度）
  createdBy String?
  createdAt DateTime @default(now())

  @@index([scope, createdAt])
}
