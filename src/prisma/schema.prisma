// ============================================================
// WHILL Scheduling Engine — Prisma schema (Phase 0)
// Tương ứng thiết kế Bước 4 (Database Design) đã xác nhận
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Tài khoản đăng nhập (管理者 / 従業員) ----------
enum UserRole {
  ADMIN
  INC      // 現在未使用（将来の拡張用に残す）
  EMPLOYEE // 従業員アカウント：月間・日別スケジュールの閲覧のみ
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(EMPLOYEE)
  employeeId   String?  @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime @default(now())
}

// ---------- Nhân viên ----------
// STAFF = 社員, CONTRACT = 契約社員, PARTTIME = バイト（既存のSTAFF/OJT/INCデータはそのまま有効）
enum EmployeeRole {
  INC
  STAFF
  CONTRACT
  PARTTIME
  OJT
}

enum CommuteType {
  TAXI_ONE_WAY
  OWN_CAR
  OTHER
}

model Employee {
  id           String       @id @default(cuid())
  fullName     String
  role         EmployeeRole @default(STAFF)
  commuteType  CommuteType?
  isActive     Boolean      @default(true)
  note         String?
  contactEmail String?     // 連絡先メールアドレス（月間スケジュール確定時の通知送信用）
  baseStartTime String?     // 基本勤務時間の開始（例: "08:00"）— 未設定なら ShiftType の時間を使う
  baseEndTime   String?     // 基本勤務時間の終了（例: "17:00"）
  user         User?
  monthRoster        MonthRoster[]
  dailyAssignments   DailyAssignment[]
  breaks             Break[]
  personalConstraints PersonalConstraint[]
  incidentFlags      IncidentFlag[]
  rotationPatterns   EmployeeRotationPattern[]
  shiftClaimRequests ShiftClaimRequest[]
  employeePriority   EmployeePriority?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------- Loại ca ----------
model ShiftType {
  id               String   @id @default(cuid())
  code             String   @unique // 明番/早番/中番/遅番/超早/超遅/INC早/INC遅
  name             String
  defaultStartTime String   // "08:00"
  defaultEndTime   String   // "17:00"
  spansMidnight    Boolean  @default(false)
  monthRoster      MonthRoster[]
}

// ---------- Master Roster (tầng tháng) ----------
enum RosterStatus {
  WORK
  OFF          // 公休（ローテーションパターンによる定期休み）
  PAID_LEAVE   // 有休
  ADJUST_LEAVE // 調整休
}

model MonthRoster {
  id          String       @id @default(cuid())
  employeeId  String
  employee    Employee     @relation(fields: [employeeId], references: [id])
  workDate    DateTime     @db.Date
  shiftTypeId String?
  shiftType   ShiftType?   @relation(fields: [shiftTypeId], references: [id])
  status      RosterStatus @default(WORK)
  overrideStartTime String? // その日だけの勤務開始時間（例外）— 未設定なら基本勤務時間/ShiftTypeを使う
  overrideEndTime   String? // その日だけの勤務終了時間（例外）
  createdBy   String?
  updatedBy   String?
  updatedAt   DateTime     @updatedAt
  createdAt   DateTime     @default(now())

  @@unique([employeeId, workDate])
  @@index([workDate])
}

// ---------- 業務 (Vị trí công việc: A cart / B cart / 全 / BF...) ----------
enum PositionCategory {
  CART
  SPECIAL // BF, 休憩, 移動, WHILL準備, WHILL片付け, MTG
}

model CartPosition {
  id       String           @id @default(cuid())
  code     String           @unique // A, B, 全, BF, BREAK, MOVE, WHILL_PREP, WHILL_CLEANUP, MTG
  name     String
  category PositionCategory
  isActive           Boolean  @default(true)  // 使用する/しない
  description        String?                  // 業務の説明
  operatingStartTime String?                  // 業務の開始時間（例: "05:00"）
  operatingEndTime   String?                  // 業務の終了時間（例: "23:00"）
  color              String?                  // 業務カラー（例: "#3b82f6"）。スケジュール画面の表示色に使用
  slotUnitMinutes    Int      @default(60)    // 60=通常（1時間単位。既存の全業務はこのまま）/ 30=管理画面で
                                                //   特別に許可された業務のみ、日別スケジュールの手動編集で
                                                //   30分単位のコマとして配置できる（自動アサインは対象外）

  operatingHours  CartOperatingHours[]
  demandTemplates DemandTemplate[]
  dailyAssignments DailyAssignment[]
  requirements    TaskRequirement[]
}

// ---------- 業務要件: 各業務に必要な人数・対象role ----------
// 現時点では「対象role」「必要人数」のみのシンプルな要件。将来的に休憩ルール・連続勤務上限・
// 業務ごとの最低/最大人数・特定社員のNG/OKなど拡張予定（拡張しやすいよう独立モデルにしている）。
model TaskRequirement {
  id                 String       @id @default(cuid())
  cartPositionId     String
  cartPosition       CartPosition @relation(fields: [cartPositionId], references: [id])
  appliesToAllRoles  Boolean      @default(true)  // true = 全役割対象、false = targetRolesのみ対象
  targetRoles        EmployeeRole[]                // appliesToAllRoles=false のときに使用
  requiredCount      Int          @default(1)      // 必要人数
  note               String?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([cartPositionId])
}

// ---------- 優先順位: 自動アサイン時にどのroleを優先するか ----------
model RolePriority {
  id            String       @id @default(cuid())
  role          EmployeeRole @unique
  priorityOrder Int          // 小さいほど優先度が高い
  updatedAt     DateTime     @updatedAt
}

// Cấu hình giờ hoạt động từng cart theo template ngày (thường/cuối tuần...)
model CartOperatingHours {
  id             String       @id @default(cuid())
  cartPositionId String
  cartPosition   CartPosition @relation(fields: [cartPositionId], references: [id])
  dayTemplate    String       // "WEEKDAY" | "WEEKEND" | "HOLIDAY" ...
  startTime      String       // "05:00"
  endTime        String       // "02:00" (qua ngày hôm sau nếu < startTime)
}

// Nhu cầu nhân lực hợp đồng theo slot 30 phút (契約仕様工数)
model DemandTemplate {
  id             String       @id @default(cuid())
  cartPositionId String
  cartPosition   CartPosition @relation(fields: [cartPositionId], references: [id])
  dayTemplate    String
  timeSlot       String       // "07:00" nghĩa là slot 07:00-07:30
  requiredCount  Int          @default(0)

  @@unique([cartPositionId, dayTemplate, timeSlot])
}

// ---------- Daily Assignment (tầng ngày/slot) — bảng lõi ----------
model DailyAssignment {
  id             String       @id @default(cuid())
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  workDate       DateTime     @db.Date
  slotStart      String       // "13:30"
  slotEnd        String       // "14:00"
  cartPositionId String
  cartPosition   CartPosition @relation(fields: [cartPositionId], references: [id])
  source         String       @default("MANUAL") // AUTO | MANUAL
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([workDate, slotStart])
  @@index([employeeId, workDate])
}

// ---------- Giờ nghỉ giải lao ----------
model Break {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  workDate        DateTime @db.Date
  breakStart      String
  breakEnd        String
  requiredMinutes Int
  actualMinutes   Int?

  @@index([employeeId, workDate])
}

// ---------- Rotation pattern (4勤2休、3勤2休、5勤2休...) ----------
// patternDefinition の構造（固定フォーマット）:
// { "cycleDays": 6, "pattern": ["WORK","WORK","WORK","WORK","OFF","OFF"] }
// ※ 出勤(WORK)/公休(OFF)のサイクルのみを決定し、勤務時間・シフト種別は決定しない
//
// オプション: 出勤日ごとに使用するShiftTypeコードを指定したい場合（例: 正社員・契約社員の
// 「4日8-17→2休→4日13-22→2休」のような、出勤日によってシフトが変わるパターン）は、
// patternと同じ長さの shiftCodes 配列を追加する:
// { "cycleDays": 12, "pattern": [...], "shiftCodes": ["早番","早番","早番","早番",null,null,"遅番","遅番","遅番","遅番",null,null] }
// shiftCodes が無い場合は従来通りstatus(WORK/OFF)のみ設定する（既存パターンは変更不要）。
model RotationPattern {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  patternDefinition Json
  isActive         Boolean  @default(true)

  employees EmployeeRotationPattern[]
}

model EmployeeRotationPattern {
  id                String          @id @default(cuid())
  employeeId        String
  employee          Employee        @relation(fields: [employeeId], references: [id])
  rotationPatternId String
  rotationPattern   RotationPattern @relation(fields: [rotationPatternId], references: [id])
  anchorDate        DateTime        @db.Date // 基準日（サイクルの1日目に対応する実際の日付）
  isCurrent         Boolean         @default(true) // 現在適用中かどうか（履歴保持のため過去分はfalseにする）
  createdAt         DateTime        @default(now())

  @@index([employeeId, isCurrent])
}

// ---------- Ràng buộc cá nhân (NG/OK) ----------
enum ConstraintType {
  NG
  OK
}

model PersonalConstraint {
  id            String         @id @default(cuid())
  employeeId    String
  employee      Employee       @relation(fields: [employeeId], references: [id])
  workDate      DateTime       @db.Date
  rangeStart    String?
  rangeEnd      String?
  constraintType ConstraintType
  note          String?

  @@index([employeeId, workDate])
}

// ---------- Ghi nhận phát sinh thực tế ----------
enum IncidentType {
  LATE            // 遅刻
  DELAY           // 遅延 ◆
  EARLY_LEAVE     // 早退
  OVERTIME        // 残業
  BF_FEE_CUT      // BF代カット ★
  OWN_CAR_COMMUTE // 車通勤 ◎
  ONE_WAY_TAXI    // 片道タクシー
}

model IncidentFlag {
  id          String       @id @default(cuid())
  employeeId  String
  employee    Employee     @relation(fields: [employeeId], references: [id])
  workDate    DateTime     @db.Date
  flagType    IncidentType
  note        String?
  recordedBy  String?
  recordedAt  DateTime     @default(now())
}

// ---------- 勤務希望申請（人員不足の日に従業員が「申請」し、INCが承認/却下する） ----------
enum ShiftClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model ShiftClaimRequest {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id])
  workDate    DateTime         @db.Date
  // 希望勤務（KIBO）の希望時間帯。null = 旧来通り「その日ならいつでも」の人員不足申請
  // ("08:00"/"17:00" など。早番=08:00-17:00, 遅番=13:00-22:00, 明番=22:00-08:00 の3種を想定)
  desiredStartTime String?
  desiredEndTime   String?
  status      ShiftClaimStatus @default(PENDING) // PENDING=未確認, APPROVED=確定, REJECTED=却下
  requestedAt DateTime         @default(now())
  decidedAt   DateTime?
  decidedBy   String?

  @@unique([employeeId, workDate])
  @@index([workDate, status])
}

// ---------- 従業員個人の優先順位（役割優先順位を補完する機能） ----------
// 「役割優先順位」（RolePriority = ロール単位）とは独立した、ロール内での個人の優先順位。
// 用途: ある時間帯で人員が不足した際に「同じロール内でどの従業員を優先的に補充要員として
// 選ぶか」を決めるためだけに使う（担当業務(A/B/全/WHILL等)の決定には使わない。
// 詳細はdocs/BUSINESS_RULES.md「従業員個人優先順位」を参照）。
model EmployeePriority {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  employee      Employee @relation(fields: [employeeId], references: [id])
  priorityOrder Int      // 小さいほど優先度が高い。同じEmployee.role同士で比較する
  updatedAt     DateTime @updatedAt
}
model RosterAuditLog {
  id         String   @id @default(cuid())
  tableName  String
  recordId   String
  action     String   // CREATE | UPDATE | DELETE
  changedBy  String?
  changedAt  DateTime @default(now())
  oldValue   Json?
  newValue   Json?

  @@index([tableName, recordId])
}
