# PostgreSQL connection string (Neon/Supabase khi deploy, hoặc local Postgres khi dev)
DATABASE_URL="postgresql://user:password@localhost:5432/whill_scheduler"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="chay-lenh:-openssl-rand--base64-32-de-tao-chuoi-ngau-nhien"

# Email thông báo lịch tháng (Resend — https://resend.com, có gói miễn phí)
# Không bắt buộc phải có ngay — nếu để trống, nút "月間スケジュール確定" sẽ chỉ báo lỗi gửi mail chứ không crash app.
# ⚠️ Đây chỉ là placeholder — KHÔNG điền key thật vào file .env.example (file này thường được chia sẻ/đưa lên Git).
# Key thật chỉ nên nằm trong file .env (đã được .gitignore).
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# AI追加 機能（ChatGPT連携）— https://platform.openai.com で取得。未設定でもアプリは正常動作する。
OPENAI_API_KEY=""

# PDF出力の日本語フォント（任意）。未設定なら同梱の fonts/ipag.ttf（IPAゴシック）を使う。
# PDF_FONT_PATH="/path/to/your-font.ttf"


# メール送信モード（勤務希望登録・シフト調整のGmail）。未設定時は本番のみ live、それ以外は dry-run（実送信しない）
# MAIL_MODE="dry-run"   # live | dry-run | test
# MAIL_TEST_TO=""       # test モード時の固定宛先
# GMAIL_USER=""
# GMAIL_APP_PASSWORD=""
# 実際のGmail送信テストを「対象を限定して」行う場合: カンマ区切りで宛先を指定（設定中はリスト外へ実送信しない）
# MAIL_ALLOWLIST="tester1@example.com,tester2@example.com"

# ※ ASK② の「メール配信」（勤務シフト確定メール）も上記 MAIL_MODE に従う。
#    開発・テストでは dry-run（実際には送信せずログ出力）にしておくこと。
